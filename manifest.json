{
  "manifest_version": 3,
  "name": "Local Home",
  "version": "1.0.0",
  "description": "A calm new tab page: search your library, notes, to-dos, stickies, sessions and weather.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "tabGroups",
    "tabs",
    "search"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}